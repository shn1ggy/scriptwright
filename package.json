{
  "name": "scriptwright",
  "productName": "Scriptwright",
  "version": "0.18.0",
  "description": "A fast, dependable screenplay editor built on Fountain.",
  "author": "Nico Sanft",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "node scripts/fetch-fonts.mjs",
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --prod",
    "start": "node scripts/build.mjs && electron .",
    "dev:browser": "node scripts/build.mjs && node dist/harness.js --port 5174",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/test.mjs",
    "e2e": "node scripts/build.mjs && node e2e/run-all.mjs",
    "dist": "node scripts/build.mjs --prod && electron-builder",
    "dist:mac": "node scripts/build.mjs --prod && electron-builder --mac",
    "dist:win": "node scripts/build.mjs --prod && electron-builder --win",
    "dist:linux": "node scripts/build.mjs --prod && electron-builder --linux",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^6.2.108",
    "playwright": "^1.56.0",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "app.scriptwright.desktop",
    "productName": "Scriptwright",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/harness.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/fonts",
        "to": "fonts",
        "filter": [
          "*.ttf",
          "*.txt"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Scriptwright-${version}-mac-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Scriptwright-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "artifactName": "Scriptwright-${version}-linux-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "fountain",
        "name": "Fountain screenplay",
        "role": "Editor"
      }
    ],
    "icon": "assets/icon.png",
    "afterPack": "scripts/after-pack.cjs",
    "publish": null,
    "dmg": {
      "artifactName": "Scriptwright-${version}-mac-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Scriptwright"
    }
  },
  "scriptwright": {
    "updateRepo": ""
  }
}
